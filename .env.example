# Redis
REDIS_URL=redis://redis:6379/0
# MongoDB — reuse the monolith's instance.
#   on the shared network:   mongodb://<your-mongo-container-name>:27017
#   published to the host:   mongodb://host.docker.internal:27017
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=pdf_extractor
# Limits / caching
BASE64_PAYLOAD_MAX_SIZE_MB=25
CACHE_TTL_SECONDS=86400